# tundra (SM8350/lahaina) on top of gki_defconfig.
# Everything tundra needs is built in (=y) and no modules are shipped.
# CONFIG_MODULES stays on because GKI vendor code (debug_kinfo, gunyah, ...)
# does not build without it.
CONFIG_LOCALVERSION="-tundra"

# GKI's built-in cmdline enables pKVM, ioremap_guard and bootconfig, none
# of which apply here (QHEE owns EL2, boot header v3). Keep only debug aids.
# earlycon=ramoops logs into the ramoops pmsg zone (0xae080000) from the
# first printk on; reboot=warm resets through PSCI SYSTEM_RESET2 so DDR,
# and with it the log, survives (plain resets are PMIC hard resets here).
CONFIG_CMDLINE="earlycon=ramoops,0xae080000 reboot=warm loglevel=8 ignore_loglevel printk.devkmsg=on panic=5 fw_devlink=permissive clk_ignore_unused pd_ignore_unused regulator_ignore_unused"
CONFIG_CMDLINE_EXTEND=y

# ramoops is the only log channel (no UART, DSC command-mode panel)
CONFIG_SERIAL_EARLYCON_RAMOOPS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Faster bring-up builds
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set

# Gunyah VM manager (enabled by gki_defconfig) is unused on lahaina.
# CONFIG_GUNYAH is not set

# SoC core needed to reach UFS: clocks, pinctrl, RPMh, regulators, SMMU
CONFIG_COMMON_CLK_QCOM=y
CONFIG_MSM_CLK_AOP_QMP=y
CONFIG_SM_GCC_LAHAINA=y
CONFIG_SM_GPUCC_LAHAINA=y
CONFIG_SM_DISPCC_LAHAINA=y
CONFIG_SM_CAMCC_LAHAINA=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_GDSC_REGULATOR=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_LAHAINA=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_SMEM=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_MAILBOX=y
CONFIG_QCOM_IPCC=y
CONFIG_MSM_QMP=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_REGULATOR_RPMH=y
CONFIG_REGULATOR_PROXY_CONSUMER=y
CONFIG_REGULATOR_REFGEN=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QTI_IOMMU_SUPPORT=y
CONFIG_QCOM_IOMMU_UTIL=y
CONFIG_QCOM_LAZY_MAPPING=y
CONFIG_IOMMU_IO_PGTABLE_FAST=y

# UFS
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_UFS=y
CONFIG_PHY_QCOM_UFS_V4=y
CONFIG_PHY_QCOM_UFS_V4_LAHAINA=y

# Interconnect: lahaina NoC providers and RPMh BCM voting (UFS, SMMU and
# most other consumers defer without them). The 6.1 icc-rpmh core always
# calls into icc-debug, so that has to be built too.
CONFIG_INTERCONNECT_QCOM_LAHAINA=y
CONFIG_INTERCONNECT_QCOM_DEBUG=y

# SPMI PMICs: arbiter, PMIC MFD, PMIC GPIOs, PON (power key and reset
# config), SDAM and PBS (used by PON), RTC
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INPUT_QPNP_POWER_ON=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_QPNP_PBS=y
CONFIG_RTC_DRV_PM8XXX=y

# Watchdog: the apps watchdog is the Haven/Gunyah virtual one
# (hypervisor:qcom,hh-watchdog), petted through hypercalls. Its driver
# sits in the GUNYAH_DRIVERS menu; the Gunyah core itself stays inert on
# Haven (no gunyah-resource-manager node).
CONFIG_QCOM_WDT_CORE=y
CONFIG_GUNYAH=y
CONFIG_GUNYAH_DRIVERS=y
CONFIG_GH_VIRT_WATCHDOG=y

# USB: dwc3-msm glue, SNPS femto HS PHY, QMP USB/DP combo SS PHY and the
# EUD (its extcon is the stock ssusb extcon; EUD itself stays disabled).
# USB_REDRIVER stays off: the stock PS5169 redriver has no 6.1 driver and
# the stub lookup lets dwc3-msm probe without it (HS only).
CONFIG_USB_DWC3_MSM=y
CONFIG_MSM_HSUSB_PHY=y
CONFIG_USB_MSM_SSPHY_QMP=y
CONFIG_QCOM_EUD=y

# Storage encryption: ICE with HWKM v1 wrapped keys, as on 5.4 (the 5.4
# fstab uses wrappedkey_v0 for FBE and metadata encryption)
CONFIG_SCSI_UFS_CRYPTO_QTI=y
CONFIG_QTI_CRYPTO_COMMON=y
CONFIG_QTI_HW_KEY_MANAGER_V1=y

# qseecom: /dev/qseecom for the stock Keymaster 4.1 HAL (and the qseecom
# kernel API for in-kernel clients through the proxy)
CONFIG_QSEECOM=y
CONFIG_QSEECOM_PROXY=y
CONFIG_QCOM_MEM_BUF_DEV=y

# DMA-BUF heaps: qcom system and CMA heaps, which the stock DT describes
# with the 5.4 qcom,msm-ion binding (see qcom_dt_parser.c)
CONFIG_QCOM_DMABUF_HEAPS=y
CONFIG_QCOM_DMABUF_HEAPS_SYSTEM=y
CONFIG_QCOM_DMABUF_HEAPS_SYSTEM_UNCACHED=y
CONFIG_QCOM_DMABUF_HEAPS_CMA=y
CONFIG_QCOM_LEGACY_ION=y
CONFIG_HW_RANDOM_MSM_LEGACY=y
CONFIG_QCOM_KGSL=y
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y
CONFIG_QCOM_ADRENO_DEFAULT_GOVERNOR="msm-adreno-tz"
# CONFIG_QCOM_KGSL_CORESIGHT is not set
CONFIG_QCOM_KGSL_IOCOHERENCY_DEFAULT=y
CONFIG_QCOM_KGSL_IDLE_TIMEOUT=80
CONFIG_QCOM_KGSL_SORT_POOL=y
CONFIG_NVMEM_QCOM_QFPROM=y

# Display: techpack/display (SDE, DSI, 5nm PLL, RSC, WB) with the panel
# event notifier for touch. Mainline DRM_MSM stays off, as on 5.4.
CONFIG_QTI_DISPLAY_LAHAINA=y
CONFIG_QCOM_PANEL_EVENT_NOTIFIER=y

# Remoteprocs: PAS loader for the ADSP (stock qcom,pil-tz-generic node,
# booted through /sys/kernel/boot_adsp by the 5.4 adsp-loader compat),
# smem/smp2p/glink transport, QRTR + QMI, sysmon/SSCTL and PDR
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_SMP2P=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_GLINK=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_NODE_ID=1

# Charging: pmic_glink to the ADSP charger PD, battery/usb/wireless supplies
CONFIG_QTI_PMIC_GLINK=y
CONFIG_QTI_BATTERY_CHARGER=y
CONFIG_QCOM_ADSP_LOADER_LEGACY=y
CONFIG_QCOM_SUBSYS_LEGACY=y

# USB role from the ADSP charger firmware over pmic_glink UCSI, as on 5.4
CONFIG_UCSI_QTI_GLINK=y

# Motorola charger drivers on top of pmic_glink, built in as on 5.4
CONFIG_MMI_ANNOTATE=y
CONFIG_MMI_INFO=y
CONFIG_BM_ADSP_ULOG=y
CONFIG_USE_MMI_CHARGER=y
CONFIG_QTI_GLINK_CHARGER=y
CONFIG_QPNP_ADAPTIVE_CHARGE=y

# Touch: Goodix GT9916S on QUP SE6 SPI (GENI + GPI DMA) with the
# Moto touchscreen class, panel events from the display, as on 5.4
CONFIG_SPI_MSM_GENI=y

# I2C GENI buses on the stock 5.4 QUP layout: aw882xx PAs, NFC,
# fsa4480/sx937x, as on 5.4
CONFIG_I2C_MSM_GENI=y
CONFIG_MSM_GPI_DMA=y
CONFIG_MMI_RELAY=y
CONFIG_SENSORS_CLASS=y
CONFIG_INPUT_TOUCHSCREEN_MMI=y
CONFIG_DRM_PANEL_EVENT_NOTIFICATIONS=y
CONFIG_DRM_DYNAMIC_REFRESH_RATE=y
CONFIG_TOUCHCLASS_MMI_MULTIWAY_UPDATE_FW=y
CONFIG_BOARD_USES_DOUBLE_TAP_CTRL=y
CONFIG_TOUCHSCREEN_GOODIX_BRL=y
CONFIG_TOUCHSCREEN_GOODIX_BRL_SPI=y
CONFIG_GTP_FOD=y
CONFIG_GTP_LIMIT_USE_SUPPLIER=y

# rmtfs: the stock qcom,sharedmem-uio node (dynamic 2.5 MiB from CMA, assigned to
# MSS_MSA) as /dev/uio for the stock rmt_storage, as on 5.4
CONFIG_UIO_MSM_SHAREDMEM=y

# Data: IPA v4.9 + GSI (techpack/dataipa, 5.4 UAPI numbering) and rmnet_mem
CONFIG_QTI_DATAIPA_LAHAINA=y
# rmnet data core (techpack/datarmnet) for netmgrd's rmnet_data netdevs
CONFIG_QTI_DATARMNET_LAHAINA=y

# fastrpc (adsprpc) for the stock DSP userspace, built in as on 5.4
CONFIG_MSM_ADSPRPC=y

# CDSP request manager (cdsprmglink-apps-dsp: CPU QoS for the CDSP), as on 5.4
CONFIG_QCOM_CDSP_RM=y

# Motorola utags (/proc/config, /proc/hw), front_temp/back_temp thermal
# zones and the Egis fingerprint driver (/dev/esfp0), built in as on 5.4
CONFIG_MOTO_UTAGS=y
CONFIG_MMI_SYS_TEMP=y
CONFIG_RBS_FPS_MMI=y
CONFIG_ET721_FOD=y
# NFC (NXP SN1xx, /dev/nq-nci) and the SX937x SAR sensor on the I2C GENI
# buses, as on 5.4
CONFIG_NFC_I2C=y
CONFIG_SARSENSOR_SX937X=y

# Built in as on 5.4: gki_defconfig has these as modules, and this kernel
# ships none (TIPC: netmgrd/qcrild need AF_TIPC; ZRAM: swapon_all)
CONFIG_BT=y
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=y
CONFIG_CRYPTO_LIB_ARC4=y
CONFIG_IKHEADERS=y
CONFIG_L2TP=y
CONFIG_MII=y
CONFIG_NFC=y
CONFIG_PPP=y
CONFIG_PPP_BSDCOMP=y
CONFIG_PPP_DEFLATE=y
CONFIG_PPP_MPPE=y
CONFIG_PPPOL2TP=y
CONFIG_PPTP=y
CONFIG_RFKILL=y
CONFIG_SLHC=y
CONFIG_TIPC=y
CONFIG_TIPC_DIAG=y

# Bluetooth: the base btpower driver (5.4-era QC snapshot, qca6490) and the
# HS GENI UART it rides on (qcom,qup_uart@890000), as on 5.4
CONFIG_MSM_BT_POWER=y
CONFIG_SERIAL_MSM_GENI=y
# 5.4 halved the UART oversampling at compile time; on 6.1 the driver derives
# it from the QUP hardware version (>= 2.5) and this only keeps the RUMI paths
CONFIG_SERIAL_MSM_GENI_HALF_SAMPLING=y
CONFIG_USB_NET_AQC111=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y
CONFIG_USB_USBNET=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# PM8350B haptics (with the boot LRA calibration), the PM8350C flash LED (with
# the multi-camera fix) and the PM8350C tri-LED on its LPG PWM, as on 5.4
CONFIG_INPUT_QCOM_HV_HAPTICS=y
CONFIG_HAPTIC_POWER_ON=y
CONFIG_LEDS_QTI_FLASH=y
CONFIG_MULTI_CAM_FLASH_STATUS=y
CONFIG_PWM_QTI_LPG=y
CONFIG_LEDS_QTI_TRI_LED=y

# Camera: techpack/camera (camera-kernel lnx.4.1 + the 5.4 Motorola delta),
# with the PMIC flash LED driver it drives the flash through.
CONFIG_QTI_CAMERA_LAHAINA=y
CONFIG_REGULATOR_WL2864C=y
CONFIG_CAMERA_VOLTAGE_COMPATIBLE=y
CONFIG_CAM_SENSOR_PROBE_RETRY=y
CONFIG_CAM_DISTINGUISH_SENSOR_VERSION=y
CONFIG_CAM_CTLE_ENABLE=y
