/*
 * tundra evb board overlay. Moto ABL picks the dtbo entry by these root
 * properties, so they match lahaina-tundra-evb-overlay.dts from 5.4
 * (including platinfo and the carrier channel-id-map); without them ABL
 * fails with "Board Dtbo blob not found".
 */

/dts-v1/;
/plugin/;

#include "carrier-channel-ids.dtsi"
#include "lahaina-tundra-overlay.dtsi"

/ {
	model = "Tundra";
	platinfo = "Qualcomm Technologies, Inc SM8350";
	compatible = "qcom,lahaina-Tundra", "qcom,lahaina-moto", "qcom,lahaina";
	qcom,msm-id = <415 0x20001>;
	qcom,board-id = <0x41 0x9100>;
};
