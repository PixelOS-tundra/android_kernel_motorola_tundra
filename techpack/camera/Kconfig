config QTI_CAMERA_LAHAINA
	bool "Qualcomm Spectra camera driver (techpack/camera) for lahaina"
	depends on ARCH_QCOM && MEDIA_CONTROLLER && VIDEO_V4L2_SUBDEV_API
	depends on QCOM_DMABUF_HEAPS && QCOM_IOMMU_UTIL
	help
	  Build the Qualcomm camera-kernel techpack (CRM, sync, SMMU, CPAS,
	  CDM, IFE/CSID, ICP, JPEG, sensor modules) into the kernel with the
	  lahaina feature set from config/lahaina.mk.

if QTI_CAMERA_LAHAINA

config AF_NOISE_ELIMINATION
	bool "For elimnating AF resonance noise"
	default n
	help
	Enable it only for produts that suffering AF resonance noise.

config CAMERA_VOLTAGE_COMPATIBLE
	bool "For camera voltage compatible"
	default n
	help
	Enable it only for produts that need voltage compatible.

config CAM_SENSOR_PROBE_RETRY
	bool "For sensor probe fail"
	default n
	help
	Add retries for sensor id matching.

config CAMERA_DISABLE_VSYNC_IRQ
	bool "For cam disable vsync irq"
	default n
	help
	Enable it to disable cam vsync irq.

config CAM_DISTINGUISH_SENSOR_VERSION
	bool "For distinguish sensor version"
	default n
	help
	Add for distinguish sensor version.

config CAMERA_SUB_DEVICE_PROBE
	bool "For cam sub device probe after sensor"
	default n
	help
	Enable it to probe cam sub devices after sensor

config CAMERA_CCI_MASTER_CHANGE
	bool "For cam cci master change"
	depends on CAMERA_SUB_DEVICE_PROBE
	default n
	help
	Enable it to switch cci master i2c address.

config CAM_CTLE_ENABLE
	bool "For cam enable ctle"
	default n
	help
	Enable it to slove signal interference.

endif

config SPECTRA_ISP
	bool "enable camera ISP modele"
	help
	  This is enabling camera ISP module.
	  IFE camera driver file be included.
	  This will enable camera ISP driver to handle IFE driver.
	  Core camera driver to handle VFE HW.

config SPECTRA_TFE
	bool "enable camera tfe modele"
	help
	  This is enabling camera tfe module.
	  tfe module files will be included to enable tfe based driver,
	  files.

config SPECTRA_OPE
	bool "enable camera OPE modele"
	help
	  This is enabling camera OPE module.
	  Camera OPE driver file be included.
	  This will enable camera OPE driver to interact with,
	  other modules.

config SPECTRA_SENSOR
	bool "enable camera sensor modele"
	help
	  This is enabling camera sensor module.
	  sensor module files will be included to enable the driver.
	  eeprom, flash, csiphy all other module will be included
	  to make the sensor functional.
