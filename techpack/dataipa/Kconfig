config QTI_DATAIPA_LAHAINA
	bool "Qualcomm IPA/GSI driver (techpack/dataipa) for lahaina"
	depends on ARCH_QCOM && NET
	select IPA3
	select QCOM_QMI_HELPERS
	select QCOM_MDT_LOADER
	help
	  Build the Qualcomm dataipa techpack (GSI, IPA v3 core, rmnet_ipa,
	  WDI/offload clients) into the kernel with the lahaina feature set
	  from config/lahainadataipa.conf, together with the rmnet_mem page
	  pool from techpack/datarmnet-ext. The UAPI headers keep the 5.4
	  msm_ipa.h/rmnet_ipa_fd_ioctl.h numbering for the stock userspace.
